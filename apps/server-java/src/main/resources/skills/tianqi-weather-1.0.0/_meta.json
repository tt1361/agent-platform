{
  "ownerId": "kn755y87neksfrcj84dqczxn5982ggav",
  "slug": "tianqi-weather",
  "version": "1.0.0",
  "publishedAt": 1773717759380,
  "plugin": {
    "type": "http-json",
    "triggerKeywords": [
      "天气",
      "气温",
      "温度",
      "下雨",
      "降雨",
      "weather"
    ],
    "request": {
      "method": "GET",
      "url": "https://wttr.in/${input.queryEncoded}",
      "query": {
        "format": "%l: %c %t, %w, %h, 降水%p"
      }
    },
    "response": {
      "listPath": "items",
      "titleField": "title",
      "snippetField": "snippet",
      "urlField": "url"
    },
    "output": {
      "topK": 1
    }
  }
}
