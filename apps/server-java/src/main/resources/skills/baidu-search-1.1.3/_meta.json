        "wd": "${input.query}"
      },
      "headers": {
        "Accept": "application/json"
      }
    },
    "response": {
      "listPath": "g",
      "titleField": "q",
      "snippetField": "q",
      "urlField": "u"
    },
    "output": {
      "topK": 10
    }
  }
